# Copy to .env (never committed — see .gitignore) and fill in real values.
# Loaded by config.py (python-dotenv) for the FastAPI backend (server/main.py).
# Restart the backend after editing.
#
# Values are .strip()ed on read, so a trailing newline pasted into a hosting
# dashboard will not silently break Airtable auth or Stripe signatures.

# --- PostgreSQL / Supabase (required for LIVE dashboard data) -------------
# Supabase → Project Settings → Database → Connection string → "Transaction"
# (port 6543). Tables are created automatically on first boot.
#
# PERCENT-ENCODE special characters in the password, or the URL silently
# reparses and the failure looks like bad credentials:
#     /  -> %2F      @  -> %40      :  -> %3A      ?  -> %3F
DATABASE_URL=postgresql://postgres.<ref>:<url-encoded-password>@<host>:6543/postgres

# --- Interactive API docs (server/main.py) --------------------------------
# Serves /docs (Swagger UI), /redoc and /openapi.json. OFF unless set, so a
# deployment that sets nothing does not publish its API schema to the world.
# The routes are not registered at all when off — they 404 with nothing behind
# them. Every endpoint they document is auth-gated either way; the reason to
# keep them closed in production is that they hand a stranger an accurate map
# of the API and serve no customer.
# Accepts 1/true/yes/on (any case); anything else, including a typo, is false.
DOCS_ENABLED=true

# --- Airtable (MIGRATION ONLY) --------------------------------------------
# No serving code reads these. They exist solely for the one-time backfill,
# scripts/migrate_airtable_to_postgres.py. Delete once it has been run.
AIRTABLE_PAT=YOUR_PERSONAL_ACCESS_TOKEN
AIRTABLE_BASE_ID=YOUR_BASE_ID
AIRTABLE_PROJECTS_TABLE=Projects
AIRTABLE_TRANSACTIONS_TABLE=Transactions
AIRTABLE_USERS_TABLE=Users

# --- Web dashboard auth (server/main.py + auth.py) -----------------------
# JWT signing key. Generate one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Keep it secret; changing it invalidates all active sessions.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12
# Months of history in the trend chart.
DASHBOARD_TREND_MONTHS=12

# Note: there is NO tenant env var — the dashboard shows the data of whoever
# logs in (their users-table Username), strictly isolated by JWT. There is also
# no demo mode: DATABASE_URL is required and every login goes to the database.

# --- Stripe billing (server/billing.py + server/webhooks.py) --------------
# Signing secret for POST /api/v1/webhooks/stripe, from Stripe Dashboard ->
# Developers -> Webhooks -> your endpoint. Subscribe the endpoint to
# checkout.session.completed AND customer.subscription.deleted. Leave blank to
# disable the endpoint (it then returns 503 instead of trusting unverified
# payloads).
STRIPE_WEBHOOK_SECRET=

# Secret API key and the RECURRING PRICE the checkout subscribes to. Both are
# needed by POST /api/v1/billing/checkout; with either missing the endpoint
# returns 503 and the /billing page says payments are not configured (rather
# than offering a button that can only fail).
# STRIPE_PRICE_ID is a Price id ("price_..."), NOT a Product id ("prod_...") —
# Stripe rejects the latter with an error that names neither field.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Public origin of the Next.js dashboard. Stripe redirects the BROWSER here
# after checkout, so it must be the address the browser can reach — not the
# API's own host.
APP_BASE_URL=http://localhost:3000

# --- Free trial (server/subscription.py) ----------------------------------
# Days of full access granted automatically at registration, with no card. When
# it elapses the account flips itself to "inactive" on its next request: reads
# still work, writes return 402 and the UI sends the user to /billing.
TRIAL_DAYS=14

# --- Local test run -------------------------------------------------------
# Nothing above is required by `pytest`: the suite runs against a throwaway
# SQLite file with its own fixed secrets (tests/conftest.py).

# --- Invoice OCR / OpenAI Vision (server/ocr.py) --------------------------
# Powers POST /api/v1/documents/scan — reading a PDF or a photo of an invoice
# into the transaction form. Get a key from platform.openai.com. Leave blank
# to disable: the endpoint returns 503 and the UI hides the scan button, rather
# than handing back a blank extraction that would be filed as a blank invoice.
OPENAI_API_KEY=
# Must be VISION-capable and support Structured Outputs; sending PDFs also
# needs a model that accepts file inputs. Override only to move to a newer
# model — both requirements fail on the first scan, not at startup.
OPENAI_MODEL=gpt-4o

# --- Error monitoring / Sentry (server/monitoring.py) ---------------------
# Leave BLANK for local development, and that is the intended state: nothing is
# initialised without a DSN, so no integrations are patched in and no event ever
# leaves your machine. An error reporter that phones home from a developer's
# laptop is a privacy problem, not a feature — and the test suite depends on
# this staying off.
#
# Take the DSN from Sentry -> Project Settings -> Client Keys. It is write-only
# ingest rather than a credential (it ships in the browser bundle of every site
# that uses Sentry), but it is set per environment so a staging deploy cannot
# pollute the production issue stream.
SENTRY_DSN=
# The tag every event is filed under. Derived when blank: "production" if the
# process is running on Render, "development" otherwise. Set it explicitly for
# a staging environment, which the derivation would otherwise call production.
SENTRY_ENVIRONMENT=
# Fraction of requests traced for performance, 0.0-1.0. Blank => 0.1 in
# production and 1.0 in development.
SENTRY_TRACES_SAMPLE_RATE=

# The FRONTEND half lives in the Next.js service, not here (web/ has its own
# environment). It needs:
#
#   NEXT_PUBLIC_SENTRY_DSN   the same DSN, or a separate project for the browser
#
# NEXT_PUBLIC_ is required — the client bundle can only see variables Next
# inlines at BUILD time — which also means it must be set BEFORE `npm run
# build`, not merely before `npm run start`. Setting it afterwards leaves an
# undefined DSN in the JavaScript and the browser reports nothing, silently.
