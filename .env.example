# Copy to .env (never committed — see .gitignore) and fill in real values.
# Loaded by config.py (python-dotenv) for BOTH the Streamlit app and the
# FastAPI web backend (server/main.py). Restart the backend after editing.

# --- Airtable (required for LIVE dashboard data) --------------------------
# Personal Access Token: https://airtable.com/create/tokens
#   scopes: data.records:read, data.records:write, schema.bases:read
#   access: the base holding your Projects/Transactions/Users tables
AIRTABLE_PAT=YOUR_PERSONAL_ACCESS_TOKEN
# Base ID: open the base → Help → API docs, or the app.airtable.com URL
# segment that starts with "app...".
AIRTABLE_BASE_ID=YOUR_BASE_ID
# Table names (defaults shown — override only if yours differ):
AIRTABLE_PROJECTS_TABLE=Projects
AIRTABLE_TRANSACTIONS_TABLE=Transactions
AIRTABLE_USERS_TABLE=Users

# --- Web dashboard auth (server/main.py + auth.py) -----------------------
# JWT signing key. Generate one:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Keep it secret; changing it invalidates all active sessions.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12
# 1 = allow the demo login (demo/demo) + demo dataset WHEN Airtable is not
# configured; 0 = require real Airtable + real Users-table accounts.
DASHBOARD_DEMO=1
# Months of history in the trend chart.
DASHBOARD_TREND_MONTHS=12

# Note: there is NO tenant env var — the dashboard shows the data of whoever
# logs in (their Airtable Users-table Username), strictly isolated by JWT.

# --- Only needed for the Streamlit app's extra features -------------------
# (invoice OCR / password-reset email / Stripe billing) — leave blank if you
# only run the web dashboard.
OPENAI_API_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
STRIPE_WEBHOOK_SECRET=
